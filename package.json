{
  "name": "forecast-notebook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/build-guide.ts && tsc --noEmit && vite build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "collect": "tsx scripts/collect.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "decimal.js": "10.6.0",
    "express": "5.1.0",
    "lossless-json": "4.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": { "node": ">=22.12.0" }
}
